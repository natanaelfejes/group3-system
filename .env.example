# Copy to .env (never commit .env).
# SIMULATOR_API_KEY: letters and digits only. Generate one with: openssl rand -hex 16
SIMULATOR_API_KEY=
# Supabase connection string (Project > Connect > Session pooler). Optional, leave empty without a database.
# If the password has special characters (@ : / # ?) it must be URL-encoded. Ask the team, never paste it in Discord.
DATABASE_URL=
# User admin API (/api/users, /api/db/desks). Off by default. There is no authentication yet and nginx exposes /api/ publicly,
# so set it to 1 ONLY when requests are authenticated (or on your own machine). Never in docker-compose or CI.
ENABLE_USER_ADMIN_API=
